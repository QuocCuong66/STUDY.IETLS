# AI chatbot keys (at least one)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin: paste the whole service account JSON on one line (Render),
# or comment it out and point GOOGLE_APPLICATION_CREDENTIALS at the key file (local).
FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Extra CORS origins, comma-separated (localhost is always allowed)
ALLOWED_ORIGINS=

PORT=8000
