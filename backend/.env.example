# AI chatbot keys (at least one)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin: paste the whole service account JSON on one line (Render),
# or leave empty locally and use the key file below.
FIREBASE_SERVICE_ACCOUNT=
# (local alternative: save the key as backend/firebase-service-account.json)

# Extra CORS origins, comma-separated (localhost is always allowed)
ALLOWED_ORIGINS=

PORT=8000
