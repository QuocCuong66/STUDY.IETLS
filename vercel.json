{
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/login", "destination": "/frontend/index.html" },
    { "source": "/speaking", "destination": "/frontend/speaking_ietls.html" },
    { "source": "/speaking_ietls", "destination": "/frontend/speaking_ietls.html" },
    { "source": "/speaking_ietls.html", "destination": "/frontend/speaking_ietls.html" },
    { "source": "/css/(.*)", "destination": "/frontend/css/$1" },
    { "source": "/js/(.*)", "destination": "/frontend/js/$1" },
    { "source": "/favicon.ico", "destination": "/frontend/favicon.ico" }
  ]
}
